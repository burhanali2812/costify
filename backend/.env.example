PORT=5000
# Comma-separated list of browser origins allowed to call the API (your deployed frontend URL)
CORS_ORIGIN=http://localhost:5173
# Set to 1 when deployed behind a proxy (Render, Railway, Nginx) so rate limiting sees real client IPs
# TRUST_PROXY=1
# Optional: lets users opt in to a Claude-written summary. Without it the built-in analysis is used.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
