{
  "name": "evm-cost-tracker-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API for the Earned Value cost tracker: validation, file parsing, AI review, PDF/CSV reports.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test \"tests/*.test.js\"",
    "test:security": "node --test --test-reporter=spec tests/security.test.js"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "pdfkit": "^0.20.2"
  },
  "overrides": {
    "uuid": "^11.1.0"
  }
}